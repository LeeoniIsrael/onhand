# Public client settings. A publishable key is preferred; legacy anonymous JWT keys are accepted.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPPORT_EMAIL=
# Local only. Release checks reject this flag when true.
EXPO_PUBLIC_LOCAL_BACKEND=false
# Server-only secrets: configure in Supabase, NEVER prefix with EXPO_PUBLIC_.
# PAYMENTS_MODE=disabled|test|live (defaults disabled)
# STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET
# OPERATIONS_SECRET (random, at least 32 characters)
# APP_ORIGIN (your HTTPS web origin)
# EXPO_PUSH_ACCESS_TOKEN (optional recommended authenticated push delivery)
# ONHAND_LOCAL_TESTS=true is accepted only for loopback/container endpoints, never hosted Supabase.
