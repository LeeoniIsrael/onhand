{
  "expo": {
    "name": "OnHand",
    "slug": "OnHand",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "onhand",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.onhand.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#214DD8",
        "foregroundImage": "./assets/brand/foreground.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.onhand.app",
      "versionCode": 1
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "image": "./assets/brand/splash.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Let OnHand attach a photo to your request.",
          "cameraPermission": "Let OnHand photograph what needs fixing.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Let OnHand locate your job or find suitable work nearby."
        }
      ],
      "expo-secure-store",
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": false
        }
      ],
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
