{
  "cli": { "version": ">=16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_LOCAL_BACKEND": "false" }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": { "EXPO_PUBLIC_LOCAL_BACKEND": "false" }
    }
  },
  "submit": { "production": {} }
}
